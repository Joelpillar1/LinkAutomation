{
    "version": 2,
    "functions": {
        "server.ts": {
            "runtime": "@vercel/node",
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "crons": [
        {
            "path": "/api/cron/process-posts",
            "schedule": "* * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/server.ts"
        },
        {
            "source": "/auth/(.*)",
            "destination": "/server.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/server.ts"
        }
    ]
}