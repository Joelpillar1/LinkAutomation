{
    "version": 2,
    "functions": {
        "server.ts": {
            "runtime": "@vercel/node",
            "memory": 1024,
            "maxDuration": 15,
            "includeFiles": "dist/**"
        }
    },
    "crons": [
        {
            "path": "/api/cron/process-posts",
            "schedule": "0 0 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/server.ts"
        },
        {
            "source": "/auth/(.*)",
            "destination": "/server.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/server.ts"
        }
    ]
}